// 忠孝國中鷹眼系統平台 - 實體關係模型
// 版本：1.0
// 更新時間：2026-01-23
// 來源：PRD jsjhPRD.md (EPIC A, EPIC B) + Clarify 決策

// ============================================
// 使用者相關
// ============================================

Table User {
  id int [pk, note: "使用者 ID"]
  account string [unique, not null, note: "登入帳號"]
  password string [not null, note: "密碼（加密儲存）"]
  role string [not null, note: "角色：管理者(admin) 或 教練(coach)"]
  failed_login_count int [default: 0, note: "連續登入失敗次數，決策 3.5"]
  locked_until string [note: "帳號鎖定到期時間，ISO 8601 格式，null 表示未鎖定，決策 3.5"]
  created_at string [not null, note: "建立時間，ISO 8601 格式"]

  Note: '''
  使用者實體
  - 登入失敗 5 次後鎖定 30 分鐘（決策 3.5）
  - 登入成功後 failed_login_count 歸零
  - 角色決定權限範圍（決策 1.1）
  '''
}

// ============================================
// 球隊相關
// ============================================

Table Team {
  id int [pk, note: "球隊 ID"]
  name string [unique, not null, note: "球隊名稱，最長 50 字元，決策 4.1"]
  created_by int [not null, ref: > User.id, note: "建立者，關聯 User，用於權限判斷，決策 1.1"]
  created_at string [not null, note: "建立時間，ISO 8601 格式，決策 2.1"]
  is_deleted bool [default: false, not null, note: "軟刪除標記，決策 1.2"]
  deleted_by int [ref: > User.id, note: "刪除者，關聯 User，決策 2.1"]
  deleted_at string [note: "刪除時間，ISO 8601 格式，決策 2.1"]

  Note: '''
  球隊實體
  - 軟刪除機制：刪除時標記 is_deleted = true（決策 1.2）
  - 刪除球隊時連帶軟刪除所有球員（決策 3.1）
  - 名稱系統內唯一（決策 4.1）
  - 教練只能操作 created_by = 自己的球隊（決策 1.1）
  '''
}

// ============================================
// 球員相關
// ============================================

Table Player {
  id int [pk, note: "球員 ID"]
  team_id int [not null, ref: > Team.id, note: "所屬球隊"]
  name string [not null, note: "球員姓名"]
  jersey_number int [not null, note: "背號，0-99，同隊唯一，決策 3.2, 3.3"]
  height int [not null, note: "身高（公分），100-220，決策 4.2"]
  position string [not null, note: "守備位置：P/C/1B/2B/3B/SS/LF/CF/RF/DH，決策 2.2"]
  sort_order int [not null, note: "排序順序，決策 3.4"]
  is_deleted bool [default: false, not null, note: "軟刪除標記，決策 1.2"]
  deleted_by int [ref: > User.id, note: "刪除者，關聯 User"]
  deleted_at string [note: "刪除時間，ISO 8601 格式"]
  created_at string [not null, note: "建立時間，ISO 8601 格式"]

  indexes {
    (team_id, jersey_number) [unique, name: "uk_team_jersey", note: "同隊背號唯一"]
  }

  Note: '''
  球員實體
  - 軟刪除機制：刪除時標記 is_deleted = true（決策 1.2）
  - 背號在同一球隊內唯一（決策 3.3）
  - 新增球員時 sort_order = 最大值 + 1（決策 6.1）
  - 守備位置只能是 10 個有效值之一（決策 2.2）
  - 一個球員只能有一個守備位置（決策 2.2）
  '''
}

// ============================================
// 列舉類型參考
// ============================================

// Role 角色
// - admin: 管理者
// - coach: 教練

// Position 守備位置（決策 2.2）
// - P: 投手 (Pitcher)
// - C: 捕手 (Catcher)
// - 1B: 一壘手 (First Baseman)
// - 2B: 二壘手 (Second Baseman)
// - 3B: 三壘手 (Third Baseman)
// - SS: 游擊手 (Shortstop)
// - LF: 左外野手 (Left Fielder)
// - CF: 中外野手 (Center Fielder)
// - RF: 右外野手 (Right Fielder)
// - DH: 指定打擊 (Designated Hitter)

// ============================================
// 業務規則摘要
// ============================================

// 權限規則（決策 1.1）
// - 管理者：可操作所有球隊和球員
// - 教練：只能操作自己建立的球隊（created_by = 自己）和其球員

// 軟刪除規則（決策 1.2, 5.1）
// - 已刪除的實體不可編輯
// - 已刪除的實體不可再次刪除
// - 已刪除的實體不出現在查詢結果中

// 級聯刪除規則（決策 3.1）
// - 刪除球隊時，連帶軟刪除所有球員
// - deleted_by 和 deleted_at 同步記錄

// 驗證規則
// - 球隊名稱：必填，最長 50 字元，系統唯一（決策 4.1）
// - 背號：0-99，同隊唯一（決策 3.2, 3.3）
// - 身高：100-220 公分（決策 4.2）
// - 守備位置：必須是有效的 10 個值之一（決策 2.2）

// 登入規則（決策 3.5）
// - 連續失敗 5 次後鎖定 30 分鐘
// - 錯誤訊息統一顯示「帳號或密碼錯誤」
// - 登入成功後失敗計數歸零

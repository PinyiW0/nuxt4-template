@startuml business-flow
!theme plain
skinparam backgroundColor #FEFEFE
skinparam defaultFontName "Noto Sans TC"

title Business Flow Diagram
caption 球隊/球員資料管理 - 業務流程圖

|用戶|
start
:進入球隊管理頁面;

|系統|
:執行 QueryTeamList;
:產生 TeamListQueried 事件;
:查詢 TeamListViewModel;
:回傳球隊列表;
note right
  **Read Model**: TeamListViewModel
  支援篩選、排序、分頁
end note

|用戶|
if (執行什麼操作?) then (建立球隊)
  :輸入球隊名稱和描述;

  |系統|
  :執行 CreateTeam;
  :產生 TeamCreationRequested;
  :驗證球隊名稱;
  
  if (驗證通過?) then (是)
    :產生 TeamValidated (isValid=true);
    :產生 TeamCreated;
    :觸發 InvalidateCache Policy;
    :產生 TeamCacheInvalidated;
    
    |用戶|
    :顯示建立成功訊息;
    stop
  else (否)
    :產生 TeamValidated (isValid=false);
    
    |用戶|
    :顯示錯誤訊息;
    note right
      可能的錯誤：
      - TEAM_NAME_DUPLICATE
      - TEAM_NAME_REQUIRED
      - TEAM_NAME_INVALID_LENGTH
    end note
    stop
  endif

elseif (選擇球隊) then
  :點擊特定球隊;

  |系統|
  :執行 SelectTeam;
  :產生 TeamSelected;
  :產生 TeamContextEstablished;
  :觸發 AutoLoadPlayers Policy;
  :自動執行 QueryPlayerList;
  :產生 PlayerListQueried;
  :查詢 PlayerListViewModel;
  :回傳球員列表;
  note right
    **Policy**: AutoLoadPlayersOnTeamSelection
    選擇球隊後自動載入球員列表
  end note

  |用戶|
  :檢視球隊和球員資訊;
  
  if (執行什麼操作?) then (新增球員)
    :輸入球員資料;
    note right
      必填：背號、姓名、守備位置
      選填：身高
    end note

    |系統|
    :執行 CreatePlayer;
    :驗證資料;
    
    if (驗證通過?) then (是)
      :產生 PlayerCreated;
      :自動分配 sortOrder (max+1);
      :觸發 RefreshPlayerList Policy;
      :產生 PlayerListRefreshed;
      
      |用戶|
      :顯示新增成功;
      :自動刷新球員列表;
      stop
    else (否)
      |用戶|
      :顯示錯誤訊息;
      note right
        可能的錯誤：
        - JERSEY_NUMBER_DUPLICATE
        - JERSEY_NUMBER_INVALID
        - POSITION_INVALID
      end note
      stop
    endif

  elseif (調整排序) then
    :拖曳調整球員順序;

    |系統|
    :執行 UpdatePlayerOrder;
    :產生 PlayerOrderChanged;
    :觸發 RefreshPlayerList Policy;
    :產生 PlayerListRefreshed;

    |用戶|
    :顯示排序更新成功;
    :自動刷新球員列表;
    stop

  elseif (編輯球員) then
    :修改球員資料;

    |系統|
    :執行 UpdatePlayer;
    :驗證資料;
    
    if (驗證通過?) then (是)
      :產生 PlayerUpdated;
      :觸發 RefreshPlayerList Policy;
      :產生 PlayerListRefreshed;
      
      |用戶|
      :顯示更新成功;
      stop
    else (否)
      |用戶|
      :顯示錯誤訊息;
      stop
    endif

  elseif (刪除球員) then
    :確認刪除;

    |系統|
    :執行 DeletePlayer;
    :產生 PlayerDeleted;
    :觸發 RefreshPlayerList Policy;
    :產生 PlayerListRefreshed;

    |用戶|
    :顯示刪除成功;
    :自動刷新球員列表;
    stop
  else (返回)
    :返回球隊列表;
    stop
  endif

elseif (編輯球隊) then
  :修改球隊資料;

  |系統|
  :執行 UpdateTeam;
  :驗證球隊名稱;
  
  if (驗證通過?) then (是)
    :產生 TeamUpdated;
    :觸發 InvalidateCache Policy;
    :產生 TeamCacheInvalidated;
    
    |用戶|
    :顯示更新成功;
    stop
  else (否)
    |用戶|
    :顯示錯誤訊息;
    stop
  endif

elseif (刪除球隊) then
  :確認刪除;
  note right
    警告：刪除球隊會一併刪除所有球員
  end note

  |系統|
  :執行 DeleteTeam;
  :產生 TeamDeleted;
  :觸發 CascadeDeletePlayers Policy;
  :產生 TeamPlayersDeleted;
  note right
    **Policy**: CascadeDeletePlayersOnTeamDeletion
    刪除球隊時自動刪除所有球員
  end note
  :觸發 InvalidateCache Policy;
  :產生 TeamCacheInvalidated;

  |用戶|
  :顯示刪除成功;
  :返回球隊列表;
  stop
else (返回)
  stop
endif

@enduml

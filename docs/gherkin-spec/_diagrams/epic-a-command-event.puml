@startuml epic-a-command-event
!theme plain
title Epic A: 登入/登出與權限控管 - Command-Event 對應

left to right direction

package "Commands" {
  usecase "Login\n登入" as C1
  usecase "Logout\n登出" as C2
}

package "Events" {
  usecase "UserLoggedIn\n使用者已登入" as E1
  usecase "UserLoginFailed\n使用者登入失敗" as E2
  usecase "UserLoggedOut\n使用者已登出" as E3
}

actor "使用者" as user

user --> C1
user --> C2

C1 --> E1 : 成功
C1 --> E2 : 失敗
C2 --> E3

note right of E1
  **Payload**:
  - userId
  - username
  - role
  - loginAt
end note

@enduml

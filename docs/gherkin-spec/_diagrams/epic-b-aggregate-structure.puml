@startuml Epic-B Aggregate Structure
!theme plain
title Epic B: 球隊/球員資料管理 - Aggregate Structure

skinparam backgroundColor #FEFEFE
skinparam class {
  BackgroundColor #FEFEFE
  BorderColor #333333
  ArrowColor #333333
}

package "Team Aggregate" <<Aggregate>> #LightYellow {
  class Team <<Entity>> {
    + teamId: UUID <<PK>>
    --
    + teamName: String {unique, case-insensitive}
    + status: Status
    + createdAt: Timestamp
    + updatedAt: Timestamp
    --
    <size:10>Invariants:</size>
    <size:10>- teamName 全系統唯一（不區分大小寫）</size>
  }
}

package "Player Aggregate" <<Aggregate>> #LightBlue {
  class Player <<Entity>> {
    + playerId: UUID <<PK>>
    --
    + teamId: UUID <<FK>>
    + jerseyNumber: Integer [0-99]
    + name: String
    + position: Position
    + height: Integer? (cm)
    + weight: Integer? (kg)
    + throwingHand: Hand?
    + battingHand: Hand?
    + sortOrder: Integer {required}
    + status: Status
    --
    <size:10>Invariants:</size>
    <size:10>- jerseyNumber 同一球隊內唯一</size>
    <size:10>- sortOrder 新增時必須指定</size>
  }
}

enum Status <<Value Object>> {
  ACTIVE
  INACTIVE
  DELETED
}

enum Position <<Value Object>> {
  P (投手)
  C (捕手)
  1B (一壘手)
  2B (二壘手)
  3B (三壘手)
  SS (游擊手)
  LF (左外野手)
  CF (中外野手)
  RF (右外野手)
  DH (指定打擊)
}

enum Hand <<Value Object>> {
  L (左)
  R (右)
  S (雙打)
}

' Relationships
Team "1" *-- "0..*" Player : contains\n(cascade delete)
Team --> Status
Player --> Status
Player --> Position
Player --> Hand

note right of Team
  <b>Boundary Decisions:</b>
  - Q2: 軟刪除 (status = DELETED)
  - Q3: 級聯刪除球員
  - Q4: 名稱不區分大小寫
end note

note right of Player
  <b>Boundary Decisions:</b>
  - Q1: 背號同隊內唯一
  - Q2: 軟刪除
  - Q5: sortOrder 手動指定
end note

@enduml

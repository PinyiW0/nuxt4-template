@startuml Epic-B Event Command Flow
!theme plain
title Epic B: 球隊/球員資料管理 - Event Command Flow

skinparam backgroundColor #FEFEFE
skinparam roundcorner 10

' Legend
legend right
  |= 顏色 |= 意義 |
  | <#FFD700> | Command |
  | <#FF6347> | Domain Event |
  | <#87CEEB> | Query |
  | <#98FB98> | Policy |
endlegend

' Actor
actor "管理者/教練" as User

' Queries
rectangle "Queries" {
  usecase "<color:#87CEEB>QueryTeamList\n查詢球隊列表</color>" as Q1
  usecase "<color:#87CEEB>QueryPlayerList\n查詢球員列表</color>" as Q2
}

' Commands
rectangle "Commands" {
  usecase "<color:#FFD700>SelectTeam\n選擇球隊</color>" as C1
  usecase "<color:#FFD700>CreateTeam\n建立球隊</color>" as C2
  usecase "<color:#FFD700>UpdateTeam\n編輯球隊</color>" as C3
  usecase "<color:#FFD700>DeleteTeam\n刪除球隊</color>" as C4
  usecase "<color:#FFD700>CreatePlayer\n建立球員</color>" as C5
  usecase "<color:#FFD700>UpdatePlayer\n編輯球員</color>" as C6
  usecase "<color:#FFD700>DeletePlayer\n刪除球員</color>" as C7
  usecase "<color:#FFD700>UpdatePlayerOrder\n調整球員排序</color>" as C8
}

' Events
rectangle "Domain Events" {
  usecase "<color:#FF6347>TeamSelected\n球隊已選擇</color>" as E1
  usecase "<color:#FF6347>TeamCreated\n球隊已建立</color>" as E2
  usecase "<color:#FF6347>TeamUpdated\n球隊已更新</color>" as E3
  usecase "<color:#FF6347>TeamDeleted\n球隊已刪除</color>" as E4
  usecase "<color:#FF6347>PlayerCreated\n球員已建立</color>" as E5
  usecase "<color:#FF6347>PlayerUpdated\n球員已更新</color>" as E6
  usecase "<color:#FF6347>PlayerDeleted\n球員已刪除</color>" as E7
  usecase "<color:#FF6347>PlayerOrderUpdated\n球員排序已更新</color>" as E8
}

' Policies
rectangle "Policies" {
  usecase "<color:#98FB98>AutoLoadPlayers\n選擇球隊後自動載入球員</color>" as P1
  usecase "<color:#98FB98>CascadeDeletePlayers\n刪除球隊時級聯刪除球員</color>" as P2
}

' User interactions
User --> Q1
User --> Q2
User --> C1
User --> C2
User --> C3
User --> C4
User --> C5
User --> C6
User --> C7
User --> C8

' Command to Event
C1 --> E1
C2 --> E2
C3 --> E3
C4 --> E4
C5 --> E5
C6 --> E6
C7 --> E7
C8 --> E8

' Policy triggers
E1 --> P1
P1 --> Q2 : triggers

E4 --> P2
P2 --> E7 : triggers\n(for each player)

@enduml

@startuml epic-d-command-event
!theme plain
title Epic D: 訓練紀錄頁（即時投球檢視） - Command-Event 對應

left to right direction

package "Commands" {
  usecase "EnterTrainingRecord\n進入訓練紀錄" as C1
  usecase "ExitTrainingRecord\n退出訓練紀錄" as C2
  usecase "AdjustStrikeZone\n調整好球帶" as C3
}

package "Events" {
  usecase "TrainingRecordEntered\n已進入訓練紀錄模式" as E1
  usecase "TrainingRecordExited\n已退出訓練紀錄模式" as E2
  usecase "PitchRecorded\n投球已記錄" as E3
  usecase "StrikeZoneAdjusted\n好球帶已調整" as E4
}

actor "AI 系統" as ai

C1 --> E1
C2 --> E2
C3 --> E4
ai --> E3 : 自動偵測

note right of E3
  **即時產生**:
  AI 系統偵測到新投球

  **Payload**:
  - pitchId
  - trainingId
  - speed
  - spinRate
  - isStrike
  - position
  - trajectory
end note

note right of E4
  **即時更新**:
  調整後九宮格
  和好壞球判定即時更新
end note

@enduml

@startuml epic-dependencies
!theme plain
title Epic 依賴關係圖

left to right direction

package "必要功能" {
  rectangle "Epic A\n登入/登出與權限控管" as A #LightBlue
}

package "核心功能" {
  rectangle "Epic B\n球隊/球員資料管理" as B #LightGreen
  rectangle "Epic C\n訓練建立與 AI 系統控制" as C #LightGreen
  rectangle "Epic D\n訓練紀錄頁\n(即時投球檢視)" as D #LightGreen
}

package "分析功能" {
  rectangle "Epic E\n影像數據分析\n(歷史訓練)" as E #LightYellow
  rectangle "Epic F\n選手分析\n(長期表現追蹤)" as F #LightYellow
  rectangle "Epic G\n影像播放\n(Live / Replay)" as G #LightYellow
}

A --> B : 需要登入
A --> C : 需要登入
A --> D : 需要登入
A --> E : 需要登入
A --> F : 需要登入
A --> G : 需要登入

B --> C : 需要球隊/球員
B --> D : 需要球員資料
B --> E : 需要球隊/球員
B --> F : 需要球員資料

C --> D : 需要訓練資料
C --> E : 需要訓練資料
C --> G : 需要 AI 系統

D --> F : 需要投球數據

note right of A
  處理順序：1
  所有功能的基礎
end note

note right of B
  處理順序：2
  訓練功能的前置條件
end note

note right of C
  處理順序：3
  產生訓練和投球數據
end note

note right of D
  處理順序：4
  即時監控投球
end note

note right of E
  處理順序：5
  歷史資料分析
end note

note right of F
  處理順序：6
  長期表現追蹤
end note

note right of G
  處理順序：7
  影像播放功能
end note

@enduml

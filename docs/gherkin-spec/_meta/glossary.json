      "zh": "AI系統",
      "en": "AISystem",
      "table": null,
      "description": "AI 偵測系統狀態",
      "fields": {
        "isRunning": { "zh": "是否運作中", "type": "boolean" },
        "startedAt": { "zh": "啟動時間", "type": "timestamp" }
      }
    }
  },

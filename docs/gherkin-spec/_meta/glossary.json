      "zh": "選手統計",
      "en": "PlayerStats",
      "table": "player_stats",
      "primaryKey": "stats_id",
      "description": "選手月統計資料",
      "fields": {
        "statsId": { "zh": "統計ID", "type": "uuid" },
        "playerId": { "zh": "球員ID", "type": "uuid", "foreignKey": "Player" },

  "entities": {
    "User": {
      "zh": "使用者",
      "en": "User",
      "table": "users",
      "primaryKey": "user_id",
      "fields": {
        "userId": { "zh": "使用者ID", "type": "uuid" },
        "username": { "zh": "帳號", "type": "string" },
        "name": { "zh": "姓名", "type": "string" },
        "role": { "zh": "角色", "type": "enum", "values": ["ADMIN", "COACH"] },
        "status": { "zh": "狀態", "type": "enum", "values": ["ACTIVE", "INACTIVE"] }
      }
    },
    "Team": {
      "zh": "球隊",
      "en": "Team",
      "table": "teams",
      "primaryKey": "team_id",
      "fields": {
        "teamId": { "zh": "球隊ID", "type": "uuid" },
        "teamName": { "zh": "球隊名稱", "type": "string" },
        "status": { "zh": "狀態", "type": "enum", "values": ["ACTIVE", "DELETED"] }
      }
    },
    "Player": {
      "zh": "球員",
      "en": "Player",
      "table": "players",
      "primaryKey": "player_id",
      "fields": {
        "playerId": { "zh": "球員ID", "type": "uuid" },
        "teamId": { "zh": "所屬球隊ID", "type": "uuid", "foreignKey": "Team" },
        "jerseyNumber": { "zh": "背號", "type": "integer", "range": [0, 99] },
        "name": { "zh": "姓名", "type": "string" },
        "height": { "zh": "身高", "type": "integer", "unit": "cm" },
        "position": { "zh": "守備位置", "type": "enum", "values": ["P", "C", "1B", "2B", "3B", "SS", "LF", "CF", "RF"] },
        "sortOrder": { "zh": "排序", "type": "integer" },
        "status": { "zh": "狀態", "type": "enum", "values": ["ACTIVE", "DELETED"] }
      }
    },
    "Training": {
      "zh": "訓練",
      "en": "Training",
      "table": "trainings",
      "primaryKey": "training_id",
      "fields": {
        "trainingId": { "zh": "訓練ID", "type": "uuid" },
        "teamId": { "zh": "球隊ID", "type": "uuid", "foreignKey": "Team" },
        "playerId": { "zh": "受測球員ID", "type": "uuid", "foreignKey": "Player" },
        "trainingDate": { "zh": "訓練日期", "type": "date" },
        "strikeZoneTop": { "zh": "好球帶上緣", "type": "decimal" },
        "strikeZoneBottom": { "zh": "好球帶下緣", "type": "decimal" },
        "status": { "zh": "狀態", "type": "enum", "values": ["ACTIVE", "DELETED"] }
      }
    },
    "Pitch": {
      "zh": "投球",
      "en": "Pitch",
      "table": "pitches",
      "primaryKey": "pitch_id",
      "fields": {
        "pitchId": { "zh": "投球ID", "type": "uuid" },
        "trainingId": { "zh": "訓練ID", "type": "uuid", "foreignKey": "Training" },
        "speed": { "zh": "球速", "type": "decimal", "unit": "km/h" },
        "spinRate": { "zh": "轉速", "type": "integer", "unit": "rpm" },
        "isStrike": { "zh": "是否好球", "type": "boolean" },
        "positionX": { "zh": "落點X座標", "type": "decimal" },
        "positionY": { "zh": "落點Y座標", "type": "decimal" },

  },
  "views": {
    "nineGrid": { "zh": "九宮格落點圖", "description": "顯示投球落點的九宮格視圖" },
    "trajectory3D": { "zh": "3D入壘軌跡", "description": "顯示投球軌跡的3D視圖" },
    "trainingRecordQuery": { "zh": "訓練記錄查詢", "description": "以訓練為維度的歷史查詢" },
    "playerRecordQuery": { "zh": "選手紀錄查詢", "description": "以選手為維度的歷史查詢" },
    "monthlyStats": { "zh": "月平均統計", "description": "選手月度統計數據" },
    "heatmap": { "zh": "熱區圖", "description": "投球落點熱區分佈圖" }
  },

      "zh": "好球帶",
      "en": "StrikeZone",
      "table": null,
      "description": "好球帶參數，依球員身高動態計算",
      "fields": {
        "top": { "zh": "上緣高度", "type": "decimal" },
        "bottom": { "zh": "下緣高度", "type": "decimal" }
      }
    },

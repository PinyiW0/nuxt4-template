        "avgSpeed": { "zh": "平均球速", "type": "decimal" },
        "avgSpinRate": { "zh": "平均轉速", "type": "integer" },
        "strikeRate": { "zh": "好球率", "type": "decimal" },
        "totalPitches": { "zh": "總投球數", "type": "integer" }
      }
    },
